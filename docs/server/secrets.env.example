# Copy values into your private secrets repo and encrypt with agenix.
# Paths expected by modules:
# - server/cloudflared.env.age
# - server/vaultwarden.env.age
# - server/vaultwarden-kdrive-backup.env.age
# - server/mariadb.env.age
# - server/linkwarden.env.age
# - server/kitchenowl.env.age
# - server/standardnotes.env.age
# - server/plane.env.age
# - server/ntfy.env.age
# - server/ntfy-monitor.token.age
# - server/beszel-hub.env.age
# - server/actual-wealthsimple.env.age
# - ntfy/android.token.age
# - ntfy/pc.token.age
# - ntfy/laptop.token.age
# - ntfy/work-laptop.token.age

# cloudflared.env
# TUNNEL_TOKEN=...

# vaultwarden.env
# ADMIN_TOKEN=...

# vaultwarden-kdrive-backup.env
# RESTIC_REPOSITORY=rclone:kdrive:Backups/restic-vaultwarden
# RESTIC_PASSWORD=generate-a-long-random-restic-password
# KDRIVE_ID=123456
# KDRIVE_USER=mail@example.com
# KDRIVE_PASSWORD=application-password-from-infomaniak

# mariadb.env
# MYSQL_ROOT_PASSWORD=...
# MYSQL_PASSWORD=...

# SECRET_KEY=...
# DEFAULT_ADMIN_EMAIL=...
# DEFAULT_ADMIN_PASSWORD=...
# DEFAULT_ADMIN_NAME=...
# DEFAULT_ADMIN_USERNAME=...

# linkwarden.env
# POSTGRES_PASSWORD=...
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@linkwarden-postgres:5432/postgres
# NEXTAUTH_URL=http://192.168.0.50:3000/api/v1/auth
# NEXTAUTH_SECRET=...
# MEILI_MASTER_KEY=...

# kitchenowl.env
# JWT_SECRET_KEY=generate-a-long-random-secret

# standardnotes.env
# Generate each value with: openssl rand -hex 32
# DB_PASSWORD and MYSQL_PASSWORD must be the same value.
# DB_PASSWORD=...
# MYSQL_ROOT_PASSWORD=...
# MYSQL_PASSWORD=...
# AUTH_JWT_SECRET=...
# AUTH_SERVER_ENCRYPTION_SERVER_KEY=...
# VALET_TOKEN_SECRET=...

# plane.env
# Generate each secret with: openssl rand -hex 32
# MACHINE_SIGNATURE=generate-a-stable-unique-machine-signature
# DATABASE_URL=postgresql://plane:<POSTGRES_PASSWORD>@plane-db:5432/plane
# AMQP_URL=amqp://plane:<RABBITMQ_PASSWORD>@plane-mq:5672/plane
# POSTGRES_PASSWORD=...
# RABBITMQ_PASSWORD=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# MINIO_ROOT_USER=...
# MINIO_ROOT_PASSWORD=...
# SECRET_KEY=...
# SILO_HMAC_SECRET_KEY=...
# AES_SECRET_KEY=...
# LIVE_SERVER_SECRET_KEY=...

# ntfy.env
# Do not use plaintext passwords in this file. Generate bcrypt hashes with
# `ntfy user hash`, then define users, topic ACLs, and tokens declaratively.
# NTFY_AUTH_USERS='ntfy-monitor:<bcrypt-hash>:user,ntfy-subscriber:<bcrypt-hash>:user'
# NTFY_AUTH_ACCESS='ntfy-monitor:homelab-alerts:wo,ntfy-subscriber:homelab-alerts:ro'
# NTFY_AUTH_TOKENS='ntfy-monitor:tk_...:Beszel,ntfy-subscriber:tk_...:Android,...'

# beszel-hub.env
# USER_EMAIL=your-admin-email@example.com
# USER_PASSWORD=generate-a-long-random-password

# actual-wealthsimple.env
# Find the Sync ID in Actual under Settings -> Show advanced settings.
# Find both Actual account IDs with: actual accounts list
# Find both Wealthsimple account IDs during the authenticated bootstrap review.
# ACTUAL_SYNC_ID=...
# ACTUAL_ACCOUNT_ID=...
# ACTUAL_CREDIT_CARD_ACCOUNT_ID=...
# ACTUAL_PASSWORD=...
# ACTUAL_ENCRYPTION_PASSWORD=... # optional; omit when encryption is disabled
# WEALTHSIMPLE_ACCOUNT_ID=...
# WEALTHSIMPLE_CREDIT_CARD_ACCOUNT_ID=...
