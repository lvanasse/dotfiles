#!/usr/bin/env bash
# Bootstrap Nix and this repository's Home Manager target on a Steam Deck.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bootstrap-steamdeck-home-manager [--repo-url URL] [--repo-dir PATH] [--dry-run]

Run this from the PC. It connects interactively to the configured `steamdeck`
SSH alias, installs Nix only when absent, clones the dotfiles repository when
needed, and applies the deck@steamdeck Home Manager configuration.
EOF
}

repo_url="https://codeberg.org/lvanasse/dotfiles.git"
repo_dir="/home/deck/Code/personal/dotfiles"
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo-url) repo_url=${2:?missing value for --repo-url}; shift 2 ;;
    --repo-dir) repo_dir=${2:?missing value for --repo-dir}; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if "$dry_run"; then
  cat <<EOF
Would open an interactive SSH session to: steamdeck
Would clean an incomplete nix-installer receipt if Nix is unavailable.
Would install upstream Nix with the Steam Deck planner only if nix is absent.
Would clone repository if absent: $repo_url -> $repo_dir
Would apply: nix run github:nix-community/home-manager/release-26.05 -- switch --flake .#deck@steamdeck
EOF
  exit 0
fi

[[ $repo_url != *[[:space:]]* && $repo_dir != *[[:space:]]* ]] || {
  printf '%s\n' 'Repository URL and directory cannot contain whitespace.' >&2
  exit 2
}

local_helper=$(mktemp)
remote_helper="/tmp/bootstrap-steamdeck-home-manager-${RANDOM}${RANDOM}.sh"
cleanup() {
  rm -f "$local_helper"
  ssh -o BatchMode=yes steamdeck rm -f -- "$remote_helper" >/dev/null 2>&1 || true
}
trap cleanup EXIT

cat > "$local_helper" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail
repo_url=$1
repo_dir=$2

if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

if ! command -v nix >/dev/null && [[ -x /nix/nix-installer && -e /nix/receipt.json ]]; then
  printf '%s\n' 'Removing the incomplete Nix installation from the previous failed attempt.'
  /nix/nix-installer uninstall --no-confirm
fi

if ! command -v nix >/dev/null; then
  printf '%s\n' 'Installing upstream Nix with the Steam Deck planner (this may request administrator authentication).'
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
    | sh -s -- install steam-deck --prefer-upstream-nix --no-confirm
fi

if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

if [[ ! -d $repo_dir/.git ]]; then
  mkdir -p "${repo_dir%/*}"
  git clone "$repo_url" "$repo_dir"
fi

cd "$repo_dir"
nix run github:nix-community/home-manager/release-26.05 -- switch --flake '.#deck@steamdeck'
REMOTE

chmod 0700 "$local_helper"
scp "$local_helper" "steamdeck:$remote_helper"
ssh -tt steamdeck bash "$remote_helper" "$repo_url" "$repo_dir"
