#!/usr/bin/env bash
# Transfer a legitimate installed Windows game to the Steam Deck and create a UMU launcher.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: deck-game-add --slug ID --name TITLE --source DIR --exe-rel PATH [options]

Transfer an already-installed Windows game to the Steam Deck, create a stable
UMU prefix and launcher, then optionally register that Linux launcher in Steam.
Quote values containing spaces or shell punctuation. Only --slug is restricted
to a machine-safe identifier; names and paths may contain normal punctuation.

Options:
  --interactive     Prompt for missing values and choose the executable
  --proton VALUE    Proton path or UMU selector (default: GE-Proton)
  --store VALUE     UMU store identifier (default: none)
  --game-id VALUE   UMU game identifier (default: umu-default)
  --sgdb-id ID      SteamGridDB game ID for canonical name and artwork
  --no-artwork      Skip SteamGridDB matching and artwork
  --no-register     Do not edit Steam shortcuts.vdf
  --dry-run         Print actions without changing the Deck
  -h, --help        Show this help
EOF
}

slug=""
name=""
source_dir=""
exe_rel=""
proton="GE-Proton"
store="none"
game_id="umu-default"
sgdb_id=""
register=true
artwork=true
dry_run=false
interactive=false

[[ $# -eq 0 ]] && interactive=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug) slug=${2:?missing value for --slug}; shift 2 ;;
    --name) name=${2:?missing value for --name}; shift 2 ;;
    --source) source_dir=${2:?missing value for --source}; shift 2 ;;
    --exe-rel) exe_rel=${2:?missing value for --exe-rel}; shift 2 ;;
    --interactive) interactive=true; shift ;;
    --proton) proton=${2:?missing value for --proton}; shift 2 ;;
    --store) store=${2:?missing value for --store}; shift 2 ;;
    --game-id) game_id=${2:?missing value for --game-id}; shift 2 ;;
    --sgdb-id) sgdb_id=${2:?missing value for --sgdb-id}; shift 2 ;;
    --no-artwork) artwork=false; shift ;;
    --no-register) register=false; shift ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

prompt_value() {
  local prompt=$1 default=${2-} value
  if [[ -n $default ]]; then
    read -er -p "$prompt [$default]: " value
    printf '%s' "${value:-$default}"
  else
    while [[ -z ${value-} ]]; do
      read -er -p "$prompt: " value
    done
    printf '%s' "$value"
  fi
}

expand_home_path() {
  local value=$1
  if [[ $value == '~' ]]; then
    value=$HOME
  elif [[ ${value:0:2} == $'\x7e/' ]]; then
    value="$HOME/${value#\~/}"
  fi
  printf '%s' "$value"
}

make_slug() {
  local value=$1
  if command -v iconv >/dev/null; then
    value=$(printf '%s' "$value" | iconv -c -t ASCII//TRANSLIT)
  fi
  value=$(printf '%s' "$value" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${value:-game}"
}

if "$interactive"; then
  [[ -t 0 ]] || {
    printf '%s\n' 'Interactive mode requires a terminal.' >&2
    exit 2
  }

  while [[ -z $source_dir || ! -d $source_dir ]]; do
    source_dir=$(prompt_value 'Installed game directory' "$source_dir")
    source_dir=$(expand_home_path "$source_dir")
    [[ -d $source_dir ]] || printf 'Directory not found: %s\n' "$source_dir" >&2
  done
  source_dir=$(realpath -e "$source_dir")

  suggested_name=${name:-$(basename "$source_dir")}
  api_key_file="${XDG_CONFIG_HOME:-$HOME/.config}/deck-game/steamgriddb-api-key"
  if "$artwork" && [[ -s $api_key_file ]]; then
    search_name=$(prompt_value 'SteamGridDB search' "$suggested_name")
    search_uri=$(printf '%s' "$search_name" | jq -sRr @uri)
    sgdb_response=$(curl -fsS \
      -H "Authorization: Bearer $(<"$api_key_file")" \
      "https://www.steamgriddb.com/api/v2/search/autocomplete/$search_uri") || {
      printf '%s\n' 'SteamGridDB search failed; continuing with the folder name.' >&2
      sgdb_response='{"data":[]}'
    }
    mapfile -t sgdb_ids < <(jq -r '.data[:10][].id' <<<"$sgdb_response")
    mapfile -t sgdb_names < <(jq -r '.data[:10][].name' <<<"$sgdb_response")
    if [[ ${#sgdb_ids[@]} -gt 0 ]]; then
      printf '%s\n' 'Choose the matching SteamGridDB game:'
      for i in "${!sgdb_ids[@]}"; do
        printf '  %d) %s [SteamGridDB %s]\n' \
          "$((i + 1))" "${sgdb_names[$i]}" "${sgdb_ids[$i]}"
      done
      printf '%s\n' '  0) Keep the folder-derived name and skip artwork'
      while :; do
        read -er -p 'Game match [1]: ' sgdb_choice
        sgdb_choice=${sgdb_choice:-1}
        if [[ $sgdb_choice == 0 ]]; then
          artwork=false
          break
        elif [[ $sgdb_choice =~ ^[0-9]+$ ]] \
          && ((sgdb_choice >= 1 && sgdb_choice <= ${#sgdb_ids[@]})); then
          sgdb_id=${sgdb_ids[sgdb_choice - 1]}
          suggested_name=${sgdb_names[sgdb_choice - 1]}
          break
        fi
        printf '%s\n' 'That SteamGridDB selection is not valid.' >&2
      done
    fi
  fi

  name=$(prompt_value 'Steam display name' "$suggested_name")
  slug=$(prompt_value 'Machine-safe slug' "${slug:-$(make_slug "$(basename "$source_dir")")}")

  if [[ -z $exe_rel ]]; then
    mapfile -d '' exe_candidates < <(
      find "$source_dir" -type f -iname '*.exe' -printf '%P\0' | sort -z
    )
    if [[ ${#exe_candidates[@]} -eq 0 ]]; then
      printf 'No Windows executables were found under: %s\n' "$source_dir" >&2
      exit 2
    elif [[ ${#exe_candidates[@]} -eq 1 ]]; then
      exe_rel=${exe_candidates[0]}
      printf 'Using the only executable found: %s\n' "$exe_rel"
    else
      printf '%s\n' 'Choose the game executable:'
      for i in "${!exe_candidates[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${exe_candidates[$i]}"
      done
      while :; do
        read -er -p 'Executable number or relative path: ' exe_choice
        if [[ $exe_choice =~ ^[0-9]+$ ]] \
          && ((exe_choice >= 1 && exe_choice <= ${#exe_candidates[@]})); then
          exe_rel=${exe_candidates[exe_choice - 1]}
          break
        elif [[ -f $source_dir/$exe_choice ]]; then
          exe_rel=$exe_choice
          break
        fi
        printf '%s\n' 'That executable selection is not valid.' >&2
      done
    fi
  fi
fi

[[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
  printf '%s\n' '--slug must use lowercase letters, digits, and hyphens.' >&2
  exit 2
}
[[ -z $sgdb_id || $sgdb_id =~ ^[0-9]+$ ]] || {
  printf '%s\n' '--sgdb-id must contain only digits.' >&2
  exit 2
}
[[ -n $name && -n $source_dir && -n $exe_rel ]] || { usage >&2; exit 2; }
[[ $exe_rel != /* ]] || {
  printf '%s\n' '--exe-rel must stay inside --source.' >&2
  exit 2
}
[[ ! $name =~ [[:cntrl:]] && ! $exe_rel =~ [[:cntrl:]] \
  && ! $proton =~ [[:cntrl:]] && ! $store =~ [[:cntrl:]] \
  && ! $game_id =~ [[:cntrl:]] ]] || {
  printf '%s\n' 'Names, paths, and UMU values cannot contain control characters.' >&2
  exit 2
}

source_dir=$(realpath -e "$source_dir")
source_exe=$(realpath -e "$source_dir/$exe_rel" 2>/dev/null) || {
  printf 'Game executable not found: %s/%s\n' "$source_dir" "$exe_rel" >&2
  exit 2
}
[[ -d $source_dir && -f $source_exe && $source_exe == "$source_dir/"* ]] || {
  printf '%s\n' '--exe-rel must resolve to a file inside --source.' >&2
  exit 2
}
exe_rel=${source_exe#"$source_dir/"}

encode_value() {
  printf '%s' "$1" | base64 --wrap=0
}

exe_rel_encoded=$(encode_value "$exe_rel")
store_encoded=$(encode_value "$store")
game_id_encoded=$(encode_value "$game_id")
name_encoded=$(encode_value "$name")

deck_game_dir="/home/deck/Games/library/$slug"
deck_launcher="/home/deck/Games/bin/$slug"
deck_config="/home/deck/Games/config/$slug.toml"
local_proton_dir=""
deck_proton="$proton"

# Prefer the PC's existing Proton build over another GitHub download on the
# Deck. This also makes the selected Proton version deterministic on both
# machines and leaves UMU's selector-based download as a fallback.
if [[ -d $proton ]]; then
  local_proton_dir=$(realpath -e "$proton")
elif [[ $proton != */* ]]; then
  mapfile -t local_proton_candidates < <(
    find "$HOME/.local/share/Steam/compatibilitytools.d" \
      -mindepth 1 -maxdepth 1 -type d -name "$proton*" -printf '%p\n' 2>/dev/null \
      | sort -V
  )
  if [[ ${#local_proton_candidates[@]} -gt 0 ]]; then
    local_proton_dir=${local_proton_candidates[-1]}
  fi
fi

if [[ -n $local_proton_dir ]]; then
  deck_proton="/home/deck/.local/share/Steam/compatibilitytools.d/$(basename "$local_proton_dir")"
fi
deck_proton_encoded=$(encode_value "$deck_proton")

printf 'Game: %s\nSource: %s\nDeck game directory: %s\nDeck prefix: /home/deck/Games/prefixes/%s\n' \
  "$name" "$source_dir" "$deck_game_dir" "$slug"
printf 'Executable: %s\n' "$exe_rel"
[[ -n $sgdb_id ]] && printf 'SteamGridDB game: %s\n' "$sgdb_id"
if [[ -n $local_proton_dir ]]; then
  printf 'Proton synchronization: %s -> %s\n' "$local_proton_dir" "$deck_proton"
fi

if "$dry_run"; then
  printf 'Would verify: ssh steamdeck umu-run and steamtinkerlaunch\n'
  printf 'Would transfer: rsync -aH --partial --info=progress2 %q/ steamdeck:%q/\n' "$source_dir" "$deck_game_dir"
  if [[ -n $local_proton_dir ]]; then
    printf 'Would synchronize Proton: rsync -aH --partial --info=progress2 %q/ steamdeck:%q/\n' \
      "$local_proton_dir" "$deck_proton"
  fi
  printf 'Would create: %s and %s\n' "$deck_config" "$deck_launcher"
  if "$register"; then
    printf 'Would manage the Deck Steam session, register and verify the shortcut, then restore the original session.\n'
  fi
  exit 0
fi

if "$interactive"; then
  read -er -p 'Transfer and register this game now? [y/N]: ' confirmation
  [[ $confirmation =~ ^[Yy]$ ]] || {
    printf '%s\n' 'Cancelled; no Deck changes were made.'
    exit 0
  }
fi

ssh steamdeck bash -s -- "$slug" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
command -v umu-run >/dev/null
command -v steamtinkerlaunch >/dev/null
mkdir -p "/home/deck/Games/library/$1"
mkdir -p "$HOME/.local/share/Steam/compatibilitytools.d"
REMOTE
rsync -aH --partial --info=progress2 "$source_dir/" "steamdeck:$deck_game_dir/"
if [[ -n $local_proton_dir ]]; then
  printf '%s\n' 'Synchronizing the PC Proton build to the Deck.'
  rsync -aH --partial --info=progress2 \
    "$local_proton_dir/" "steamdeck:$deck_proton/"
fi

ssh steamdeck bash -s -- \
  "$slug" "$exe_rel_encoded" "$deck_proton_encoded" "$store_encoded" "$game_id_encoded" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
slug=$1
decode_value() {
  printf '%s' "$1" | base64 --decode
}
toml_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}
exe_rel=$(decode_value "$2")
proton=$(decode_value "$3")
store=$(decode_value "$4")
game_id=$(decode_value "$5")
game_dir="/home/deck/Games/library/$slug"
prefix="/home/deck/Games/prefixes/$slug"
config="/home/deck/Games/config/$slug.toml"
launcher="/home/deck/Games/bin/$slug"

test -f "$game_dir/$exe_rel"
mkdir -p "$prefix" "${config%/*}" "${launcher%/*}"
printf '%s\n' 'Preparing the Deck Proton build and UMU prefix.'
env \
  WINEPREFIX="$prefix" \
  GAMEID="$game_id" \
  STORE="$store" \
  PROTONPATH="$proton" \
  umu-run ""

if [[ -d $proton ]]; then
  resolved_proton=$(realpath -e "$proton")
else
  mapfile -t proton_candidates < <(
    find "$HOME/.local/share/Steam/compatibilitytools.d" \
      -mindepth 1 -maxdepth 1 -type d -name "$proton*" -printf '%p\n' 2>/dev/null \
      | sort -V
  )
  [[ ${#proton_candidates[@]} -gt 0 ]] || {
    printf 'UMU did not install a Proton build matching: %s\n' "$proton" >&2
    exit 6
  }
  resolved_proton=${proton_candidates[-1]}
fi

prefix_toml=$(toml_escape "$prefix")
exe_toml=$(toml_escape "$game_dir/$exe_rel")
proton_toml=$(toml_escape "$resolved_proton")
game_id_toml=$(toml_escape "$game_id")
store_toml=$(toml_escape "$store")
cat > "$config" <<EOF
[umu]
prefix = "$prefix_toml"
exe = "$exe_toml"
proton = "$proton_toml"
game_id = "$game_id_toml"
store = "$store_toml"
EOF
cat > "$launcher" <<EOF
#!/bin/bash
set -euo pipefail
unset LD_PRELOAD LD_LIBRARY_PATH
export PATH="\$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:\$PATH"
export WINEPREFIX=$(printf '%q' "$prefix")
export GAMEID=$(printf '%q' "$game_id")
export STORE=$(printf '%q' "$store")
export PROTONPATH=$(printf '%q' "$proton")
exec "\$HOME/.nix-profile/bin/umu-run" $(printf '%q' "$game_dir/$exe_rel") "\$@"
EOF
chmod 0755 "$launcher"
REMOTE

if "$register"; then
  deck_mode() {
    ssh steamdeck '
      if pgrep -x plasmashell >/dev/null; then
        printf "%s\n" desktop
      elif ps -C steam -o args= 2>/dev/null | grep -q -- "-gamepadui"; then
        printf "%s\n" gaming
      else
        printf "%s\n" unknown
      fi
    '
  }

  wait_for_deck_mode() {
    local wanted=$1 current attempt
    for ((attempt = 1; attempt <= 45; attempt++)); do
      if current=$(deck_mode 2>/dev/null) && [[ $current == "$wanted" ]]; then
        return 0
      fi
      sleep 2
    done
    printf 'Timed out waiting for Deck mode: %s\n' "$wanted" >&2
    return 1
  }

  wait_for_steam_state() {
    local wanted=$1 current attempt
    for ((attempt = 1; attempt <= 30; attempt++)); do
      if ssh steamdeck 'pgrep -x steam >/dev/null' 2>/dev/null; then
        current=running
      else
        current=closed
      fi
      [[ $current == "$wanted" ]] && return 0
      sleep 2
    done
    printf 'Timed out waiting for Steam to be %s.\n' "$wanted" >&2
    return 1
  }

  shortcut_is_registered() {
    ssh steamdeck bash -s -- "$slug" <<'REMOTE'
set -euo pipefail
slug=$1
steam_userdata="$HOME/.local/share/Steam/userdata"
mapfile -t steam_user_ids < <(
  find "$steam_userdata" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
    | grep -E '^[0-9]+$' \
    | sort -n
)
[[ ${#steam_user_ids[@]} -eq 1 ]]
shortcut_file="$steam_userdata/${steam_user_ids[0]}/config/shortcuts.vdf"
[[ -s $shortcut_file ]]
# The stable launcher path is the game identity. Display names are metadata and
# may be refined later without creating a duplicate Steam shortcut.
strings "$shortcut_file" | grep -Fqx -- "\"/home/deck/Games/bin/$slug\""
REMOTE
  }

  shortcut_already_registered=false
  if shortcut_is_registered; then
    printf '%s\n' 'Steam shortcut is already registered and verified.'
    shortcut_already_registered=true
  fi

  initial_mode=$(deck_mode)
  if [[ $initial_mode == unknown ]]; then
    printf '%s\n' 'Could not identify the Deck graphical session.' >&2
    exit 3
  fi
  if ssh steamdeck 'pgrep -x steam >/dev/null'; then
    steam_was_running=true
  else
    steam_was_running=false
  fi
  restore_required=false

  restore_deck_session() {
    local status=$?
    if "$restore_required"; then
      printf '%s\n' 'Restoring the original Deck session after an error.' >&2
      if [[ $initial_mode == gaming ]]; then
        ssh steamdeck 'steamosctl switch-to-game-mode' >/dev/null 2>&1 || true
      elif "$steam_was_running"; then
        ssh steamdeck 'systemctl --user start app-steam@autostart.service' >/dev/null 2>&1 || true
      fi
    fi
    return "$status"
  }
  trap restore_deck_session EXIT

  if [[ $initial_mode == gaming ]]; then
    restore_required=true
    printf '%s\n' 'Switching the Deck to Desktop Mode for safe shortcut registration.'
    ssh steamdeck 'steamosctl switch-to-desktop-mode plasma.desktop'
    wait_for_deck_mode desktop
  elif "$steam_was_running"; then
    restore_required=true
  fi

  if ssh steamdeck 'pgrep -x steam >/dev/null'; then
    printf '%s\n' 'Closing Steam on the Deck.'
    ssh steamdeck '/usr/bin/steam -shutdown'
    wait_for_steam_state closed
  fi

  if ! "$shortcut_already_registered"; then
    ssh steamdeck bash -s -- "$name_encoded" "$slug" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
name=$(printf '%s' "$1" | base64 --decode)
slug=$2

steam_userdata="$HOME/.local/share/Steam/userdata"
mapfile -t steam_user_ids < <(
  find "$steam_userdata" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
    | grep -E '^[0-9]+$' \
    | sort -n
)
if [[ ${#steam_user_ids[@]} -ne 1 ]]; then
  printf 'Expected exactly one Steam userdata directory in %s; found %d.\n' \
    "$steam_userdata" "${#steam_user_ids[@]}" >&2
  exit 4
fi
steam_user_id=${steam_user_ids[0]}

# SteamTinkerLaunch releases that predate the current loginusers.vdf format can
# fail to identify the active account when Steam is closed. Its global config
# supports an explicit short Steam user ID, so keep that value deterministic.
stl_config="$HOME/.config/steamtinkerlaunch/global.conf"
mkdir -p "${stl_config%/*}"
if [[ -f $stl_config ]] && grep -q '^STEAMUSERID=' "$stl_config"; then
  sed -i -E "s/^STEAMUSERID=.*/STEAMUSERID=\"$steam_user_id\"/" "$stl_config"
else
  printf 'STEAMUSERID="%s"\n' "$steam_user_id" >> "$stl_config"
fi
rm -f \
  /dev/shm/steamtinkerlaunch/steampaths.txt \
  /dev/shm/steamtinkerlaunch/LoginUsersCSV.txt

steamtinkerlaunch ansg \
  --appname="$name" \
  --exepath="/home/deck/Games/bin/$slug" \
  --startdir="/home/deck/Games/library/$slug"

shortcut_file="$steam_userdata/$steam_user_id/config/shortcuts.vdf"
if [[ ! -s $shortcut_file ]] || ! strings "$shortcut_file" | grep -Fqx -- "$name"; then
  printf 'SteamTinkerLaunch did not write %s to %s.\n' "$name" "$shortcut_file" >&2
  exit 5
fi
REMOTE
  fi

  shortcut_app_id=$(ssh steamdeck python3 - "$slug" <<'PY'
import pathlib
import struct
import sys

slug = sys.argv[1]
launcher = f'/home/deck/Games/bin/{slug}'.encode()
userdata = pathlib.Path.home() / ".local/share/Steam/userdata"
users = sorted(path for path in userdata.iterdir() if path.is_dir() and path.name.isdigit())
if len(users) != 1:
    raise SystemExit(f"expected one Steam userdata directory, found {len(users)}")
data = (users[0] / "config/shortcuts.vdf").read_bytes()
identity_marker = b'\x01Exe\x00"' + launcher + b'"\x00'
identity_offset = data.find(identity_marker)
if identity_offset < 0:
    raise SystemExit("shortcut launcher not found")
appid_marker = b"\x02appid\x00"
appid_offset = data.rfind(appid_marker, 0, identity_offset)
if appid_offset < 0:
    raise SystemExit("shortcut AppID not found")
print(struct.unpack_from("<I", data, appid_offset + len(appid_marker))[0])
PY
  )

  ssh steamdeck python3 - "$shortcut_app_id" <<'PY'
import pathlib
import shutil
import sys
import time

appid = sys.argv[1]
config = pathlib.Path.home() / ".local/share/Steam/config/config.vdf"
lines = config.read_text().splitlines(keepends=True)
target = f'"{appid}"'
section = next((i for i, line in enumerate(lines) if line.strip() == '"CompatToolMapping"'), None)
if section is None:
    raise SystemExit(0)

start = None
for i in range(section + 1, len(lines)):
    if lines[i].strip() == target:
        start = i
        break
    if lines[i].strip() == '"Tools"':
        break
if start is None:
    raise SystemExit(0)

brace = start + 1
while brace < len(lines) and lines[brace].strip() != "{":
    brace += 1
if brace == len(lines):
    raise SystemExit("invalid compatibility mapping")
depth = 0
end = None
for i in range(brace, len(lines)):
    depth += lines[i].count("{")
    depth -= lines[i].count("}")
    if depth == 0:
        end = i + 1
        break
if end is None:
    raise SystemExit("unterminated compatibility mapping")

backup = config.with_name(f"config.vdf.deck-game-backup-{int(time.time())}")
shutil.copy2(config, backup)
temp = config.with_suffix(".vdf.deck-game-tmp")
temp.write_text("".join(lines[:start] + lines[end:]))
temp.replace(config)
print(f"Removed Steam compatibility mapping for {appid}; backup: {backup}")
PY

  if "$artwork" && [[ -n $sgdb_id ]]; then
    artwork_helper=$(command -v deck-game-artwork || true)
    [[ -n $artwork_helper ]] || artwork_helper="$(dirname "$0")/deck-game-artwork"
    [[ -x $artwork_helper ]] || {
      printf 'Artwork helper is not installed: %s\n' "$artwork_helper" >&2
      exit 7
    }
    "$artwork_helper" \
      --name "$name" \
      --sgdb-id "$sgdb_id" \
      --shortcut-id "$shortcut_app_id"
  fi

  if [[ $initial_mode == gaming ]]; then
    printf '%s\n' 'Restoring Gaming Mode.'
    ssh steamdeck 'steamosctl switch-to-game-mode'
    wait_for_deck_mode gaming
  elif "$steam_was_running"; then
    printf '%s\n' 'Restarting the Steam desktop client.'
    ssh steamdeck 'systemctl --user start app-steam@autostart.service'
    wait_for_steam_state running
  fi
  restore_required=false
  trap - EXIT
  printf '%s\n' 'Game shortcut and artwork are ready; the original Deck session was restored.'
else
  printf '%s\n' 'Deck launcher created; Steam shortcut registration was skipped.'
fi
