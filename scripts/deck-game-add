#!/usr/bin/env bash
# Transfer a legitimate installed Windows game to the Steam Deck and create a UMU launcher.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: deck-game-add --slug ID --name TITLE --source DIR --exe-rel PATH [options]

Transfer an already-installed Windows game to the Steam Deck, create a stable
UMU prefix and launcher, then optionally register that Linux launcher in Steam.
Quote values containing spaces or shell punctuation. Only --slug is restricted
to a machine-safe identifier; names and paths may contain normal punctuation.

Options:
  --proton VALUE    Proton path or UMU selector (default: GE-Proton)
  --store VALUE     UMU store identifier (default: none)
  --game-id VALUE   UMU game identifier (default: umu-default)
  --no-register     Do not edit Steam shortcuts.vdf
  --dry-run         Print actions without changing the Deck
  -h, --help        Show this help
EOF
}

slug=""
name=""
source_dir=""
exe_rel=""
proton="GE-Proton"
store="none"
game_id="umu-default"
register=true
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug) slug=${2:?missing value for --slug}; shift 2 ;;
    --name) name=${2:?missing value for --name}; shift 2 ;;
    --source) source_dir=${2:?missing value for --source}; shift 2 ;;
    --exe-rel) exe_rel=${2:?missing value for --exe-rel}; shift 2 ;;
    --proton) proton=${2:?missing value for --proton}; shift 2 ;;
    --store) store=${2:?missing value for --store}; shift 2 ;;
    --game-id) game_id=${2:?missing value for --game-id}; shift 2 ;;
    --no-register) register=false; shift ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
  printf '%s\n' '--slug must use lowercase letters, digits, and hyphens.' >&2
  exit 2
}
[[ -n $name && -n $source_dir && -n $exe_rel ]] || { usage >&2; exit 2; }
[[ $exe_rel != /* ]] || {
  printf '%s\n' '--exe-rel must stay inside --source.' >&2
  exit 2
}
[[ ! $name =~ [[:cntrl:]] && ! $exe_rel =~ [[:cntrl:]] \
  && ! $proton =~ [[:cntrl:]] && ! $store =~ [[:cntrl:]] \
  && ! $game_id =~ [[:cntrl:]] ]] || {
  printf '%s\n' 'Names, paths, and UMU values cannot contain control characters.' >&2
  exit 2
}

source_dir=$(realpath -e "$source_dir")
source_exe=$(realpath -e "$source_dir/$exe_rel" 2>/dev/null) || {
  printf 'Game executable not found: %s/%s\n' "$source_dir" "$exe_rel" >&2
  exit 2
}
[[ -d $source_dir && -f $source_exe && $source_exe == "$source_dir/"* ]] || {
  printf '%s\n' '--exe-rel must resolve to a file inside --source.' >&2
  exit 2
}
exe_rel=${source_exe#"$source_dir/"}

encode_value() {
  printf '%s' "$1" | base64 --wrap=0
}

exe_rel_encoded=$(encode_value "$exe_rel")
proton_encoded=$(encode_value "$proton")
store_encoded=$(encode_value "$store")
game_id_encoded=$(encode_value "$game_id")
name_encoded=$(encode_value "$name")

deck_game_dir="/home/deck/Games/library/$slug"
deck_launcher="/home/deck/Games/bin/$slug"
deck_config="/home/deck/Games/config/$slug.toml"

printf 'Game: %s\nSource: %s\nDeck game directory: %s\nDeck prefix: /home/deck/Games/prefixes/%s\n' \
  "$name" "$source_dir" "$deck_game_dir" "$slug"
printf 'Executable: %s\n' "$exe_rel"

if "$dry_run"; then
  printf 'Would verify: ssh steamdeck umu-run and steamtinkerlaunch\n'
  printf 'Would transfer: rsync -aH --partial --info=progress2 %q/ steamdeck:%q/\n' "$source_dir" "$deck_game_dir"
  printf 'Would create: %s and %s\n' "$deck_config" "$deck_launcher"
  if "$register"; then
    printf 'Would manage the Deck Steam session, register and verify the shortcut, then restore the original session.\n'
  fi
  exit 0
fi

ssh steamdeck bash -s -- "$slug" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
command -v umu-run >/dev/null
command -v steamtinkerlaunch >/dev/null
mkdir -p "/home/deck/Games/library/$1"
REMOTE
rsync -aH --partial --info=progress2 "$source_dir/" "steamdeck:$deck_game_dir/"

ssh steamdeck bash -s -- \
  "$slug" "$exe_rel_encoded" "$proton_encoded" "$store_encoded" "$game_id_encoded" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
slug=$1
decode_value() {
  printf '%s' "$1" | base64 --decode
}
toml_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}
exe_rel=$(decode_value "$2")
proton=$(decode_value "$3")
store=$(decode_value "$4")
game_id=$(decode_value "$5")
game_dir="/home/deck/Games/library/$slug"
prefix="/home/deck/Games/prefixes/$slug"
config="/home/deck/Games/config/$slug.toml"
launcher="/home/deck/Games/bin/$slug"

test -f "$game_dir/$exe_rel"
mkdir -p "$prefix" "${config%/*}" "${launcher%/*}"
prefix_toml=$(toml_escape "$prefix")
exe_toml=$(toml_escape "$game_dir/$exe_rel")
proton_toml=$(toml_escape "$proton")
game_id_toml=$(toml_escape "$game_id")
store_toml=$(toml_escape "$store")
cat > "$config" <<EOF
[umu]
prefix = "$prefix_toml"
exe = "$exe_toml"
proton = "$proton_toml"
game_id = "$game_id_toml"
store = "$store_toml"
EOF
cat > "$launcher" <<EOF
#!/usr/bin/env bash
set -euo pipefail
export PATH="\$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:\$PATH"
exec umu-run --config "$config" "\$@"
EOF
chmod 0755 "$launcher"
REMOTE

if "$register"; then
  deck_mode() {
    ssh steamdeck '
      if pgrep -x plasmashell >/dev/null; then
        printf "%s\n" desktop
      elif ps -C steam -o args= 2>/dev/null | grep -q -- "-gamepadui"; then
        printf "%s\n" gaming
      else
        printf "%s\n" unknown
      fi
    '
  }

  wait_for_deck_mode() {
    local wanted=$1 current attempt
    for ((attempt = 1; attempt <= 45; attempt++)); do
      if current=$(deck_mode 2>/dev/null) && [[ $current == "$wanted" ]]; then
        return 0
      fi
      sleep 2
    done
    printf 'Timed out waiting for Deck mode: %s\n' "$wanted" >&2
    return 1
  }

  wait_for_steam_state() {
    local wanted=$1 current attempt
    for ((attempt = 1; attempt <= 30; attempt++)); do
      if ssh steamdeck 'pgrep -x steam >/dev/null' 2>/dev/null; then
        current=running
      else
        current=closed
      fi
      [[ $current == "$wanted" ]] && return 0
      sleep 2
    done
    printf 'Timed out waiting for Steam to be %s.\n' "$wanted" >&2
    return 1
  }

  shortcut_is_registered() {
    ssh steamdeck bash -s -- "$name_encoded" "$slug" <<'REMOTE'
set -euo pipefail
name=$(printf '%s' "$1" | base64 --decode)
slug=$2
steam_userdata="$HOME/.local/share/Steam/userdata"
mapfile -t steam_user_ids < <(
  find "$steam_userdata" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
    | grep -E '^[0-9]+$' \
    | sort -n
)
[[ ${#steam_user_ids[@]} -eq 1 ]]
shortcut_file="$steam_userdata/${steam_user_ids[0]}/config/shortcuts.vdf"
[[ -s $shortcut_file ]]
strings "$shortcut_file" | grep -Fqx -- "$name"
strings "$shortcut_file" | grep -Fqx -- "\"/home/deck/Games/bin/$slug\""
REMOTE
  }

  if shortcut_is_registered; then
    printf '%s\n' 'Steam shortcut is already registered and verified.'
    exit 0
  fi

  initial_mode=$(deck_mode)
  if [[ $initial_mode == unknown ]]; then
    printf '%s\n' 'Could not identify the Deck graphical session.' >&2
    exit 3
  fi
  if ssh steamdeck 'pgrep -x steam >/dev/null'; then
    steam_was_running=true
  else
    steam_was_running=false
  fi
  restore_required=false

  restore_deck_session() {
    local status=$?
    if "$restore_required"; then
      printf '%s\n' 'Restoring the original Deck session after an error.' >&2
      if [[ $initial_mode == gaming ]]; then
        ssh steamdeck 'steamosctl switch-to-game-mode' >/dev/null 2>&1 || true
      elif "$steam_was_running"; then
        ssh steamdeck 'systemctl --user start app-steam@autostart.service' >/dev/null 2>&1 || true
      fi
    fi
    return "$status"
  }
  trap restore_deck_session EXIT

  if [[ $initial_mode == gaming ]]; then
    restore_required=true
    printf '%s\n' 'Switching the Deck to Desktop Mode for safe shortcut registration.'
    ssh steamdeck 'steamosctl switch-to-desktop-mode plasma.desktop'
    wait_for_deck_mode desktop
  elif "$steam_was_running"; then
    restore_required=true
  fi

  if ssh steamdeck 'pgrep -x steam >/dev/null'; then
    printf '%s\n' 'Closing Steam on the Deck.'
    ssh steamdeck '/usr/bin/steam -shutdown'
    wait_for_steam_state closed
  fi

  ssh steamdeck bash -s -- "$name_encoded" "$slug" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
name=$(printf '%s' "$1" | base64 --decode)
slug=$2

steam_userdata="$HOME/.local/share/Steam/userdata"
mapfile -t steam_user_ids < <(
  find "$steam_userdata" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
    | grep -E '^[0-9]+$' \
    | sort -n
)
if [[ ${#steam_user_ids[@]} -ne 1 ]]; then
  printf 'Expected exactly one Steam userdata directory in %s; found %d.\n' \
    "$steam_userdata" "${#steam_user_ids[@]}" >&2
  exit 4
fi
steam_user_id=${steam_user_ids[0]}

# SteamTinkerLaunch releases that predate the current loginusers.vdf format can
# fail to identify the active account when Steam is closed. Its global config
# supports an explicit short Steam user ID, so keep that value deterministic.
stl_config="$HOME/.config/steamtinkerlaunch/global.conf"
mkdir -p "${stl_config%/*}"
if [[ -f $stl_config ]] && grep -q '^STEAMUSERID=' "$stl_config"; then
  sed -i -E "s/^STEAMUSERID=.*/STEAMUSERID=\"$steam_user_id\"/" "$stl_config"
else
  printf 'STEAMUSERID="%s"\n' "$steam_user_id" >> "$stl_config"
fi
rm -f \
  /dev/shm/steamtinkerlaunch/steampaths.txt \
  /dev/shm/steamtinkerlaunch/LoginUsersCSV.txt

steamtinkerlaunch ansg \
  --appname="$name" \
  --exepath="/home/deck/Games/bin/$slug" \
  --startdir="/home/deck/Games/library/$slug"

shortcut_file="$steam_userdata/$steam_user_id/config/shortcuts.vdf"
if [[ ! -s $shortcut_file ]] || ! strings "$shortcut_file" | grep -Fqx -- "$name"; then
  printf 'SteamTinkerLaunch did not write %s to %s.\n' "$name" "$shortcut_file" >&2
  exit 5
fi
REMOTE

  if [[ $initial_mode == gaming ]]; then
    printf '%s\n' 'Restoring Gaming Mode.'
    ssh steamdeck 'steamosctl switch-to-game-mode'
    wait_for_deck_mode gaming
  elif "$steam_was_running"; then
    printf '%s\n' 'Restarting the Steam desktop client.'
    ssh steamdeck 'systemctl --user start app-steam@autostart.service'
    wait_for_steam_state running
  fi
  restore_required=false
  trap - EXIT
  printf '%s\n' 'Shortcut registered and the original Deck session was restored.'
else
  printf '%s\n' 'Deck launcher created; Steam shortcut registration was skipped.'
fi
